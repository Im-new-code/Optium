{
  "schemaVersion": 1,
  "id": "optium",
  "version": "${version}",
  "name": "Optium",
  "description": "Fabric bridge for a separately supplied OptiFine JAR; automatically bypasses OptiFine when Sodium/Iris owns rendering",
  "authors": ["Optium contributors", "Modmuss50", "Chocohead"],
  "contact": {
    "homepage": "https://github.com/Im-new-code/Optium",
    "sources": "https://github.com/Im-new-code/Optium",
    "issues": "https://github.com/Im-new-code/Optium/issues"
  },
  "mixins": ["optium.mixins.json"],
  "license": "MPL-2.0",
  "icon": "assets/optium/icon.png",
  "environment": "client",
  "entrypoints": {
    "mm:early_risers": [
      "me.modmuss50.optium.mod.TextSetup",
      "me.modmuss50.optium.mod.OptiumSetup"
    ],
    "preLaunch": ["me.modmuss50.optium.mod.OptiumLoadGuard"],
    "client": ["me.modmuss50.optium.mod.OptiumClient"]
  },
  "custom": {
    "fabric-renderer-indigo:force_compatibility": true
  },
  "depends": {
    "fabricloader": ">=0.12.0",
    "minecraft": [
      "1.16.1", "1.16.2", "1.16.3", "1.16.4", "1.16.5",
      "1.17-alpha.21.8.b", "1.17-beta.4", "1.17", "1.17.1",
      "1.18-beta.1", "1.18", "1.18.1", "1.18.2",
      "1.19", "1.19.1", "1.19.2"
    ],
    "mm": ">=2.0"
  },
  "breaks": {
    "no_fog": "*",
    "thallium": "*",
    "xradiation": "*",
    "cardinal-components-item": "<2.4.2",
    "architectury": ">1.2.72 <1.3.77",
    "meteor-client": ">=0.4.1"
  }
}
